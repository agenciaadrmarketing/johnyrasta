# /etc/johnyweb/worker.env  (chmod 640, dono root:johnyweb)
NODE_ENV=production
APP_URL=
# Papel do worker via pooler em modo SESSÃO (porta 5432 do pooler, IPv4).
DATABASE_URL_WORKER=
DATABASE_SSL_CA_FILE=/etc/johnyweb/supabase-ca.crt
WORKER_ID=vps-1
MONITOR_CONCORRENCIA=5
PAGESPEED_CONCORRENCIA=2
# Pool do worker (padrão: MONITOR_CONCORRENCIA + PAGESPEED_CONCORRENCIA + 4 = 11).
# DB_POOL_MAX=
# DEIXE VAZIA em produção:
MONITOR_EXCECOES_DE_REDE=
PAGESPEED_API_KEY=
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# EMAIL_WEBHOOK_URL=
