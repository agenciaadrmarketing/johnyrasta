# /etc/johnyweb/ops.env — usado SÓ por quem roda db:setup/db:migrate/db:bootstrap/db:backup/db:supabase-*, nunca pelos serviços.
# chmod 600. Carregue com:  set -a; . /etc/johnyweb/ops.env; set +a
# Administrador via pooler em modo SESSÃO (porta 5432 do pooler) ou conexão direta se a VPS tiver IPv6.
# Precisa de CREATEROLE e BYPASSRLS (o preflight confere). Usuário = postgres.<ref>.
DATABASE_URL_ADMIN=
# As quatro URLs dos papéis são necessárias ao db:setup (ele lê delas as senhas). Podem ser as mesmas dos serviços.
DATABASE_URL=
DATABASE_URL_WORKER=
DATABASE_URL_INGEST=
DATABASE_URL_FORMS=
# <ref do projeto>: o db:setup remove ".<ref>" do usuário para obter o nome do papel.
DB_ROLE_SUFFIX=
DATABASE_SSL_CA_FILE=/etc/johnyweb/supabase-ca.crt
BACKUP_DIR=/var/backups/johnyweb
