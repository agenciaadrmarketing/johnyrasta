# /etc/johnyweb/web.env  (chmod 640, dono root:johnyweb) — SÓ nomes; valores no servidor, nunca no repositório.
NODE_ENV=production
# Endereço público desta instalação, sem barra final. Provisório primeiro; troque no dia da virada (veja o roteiro).
APP_URL=
# Papéis da aplicação via POOLER do Supabase, modo TRANSAÇÃO (porta 6543). Usuário = papel.<ref do projeto>.
DATABASE_URL=
DATABASE_URL_INGEST=
DATABASE_URL_FORMS=
# Certificado raiz do projeto Supabase (baixe no painel, em Database → SSL) salvo neste caminho.
DATABASE_SSL_CA_FILE=/etc/johnyweb/supabase-ca.crt
# Conexões por papel nesta instância (3 papéis × valor). Comece com 5.
DB_POOL_MAX=5
# Diagnóstico de lentidão: registra cada transação com duração e nº de consultas. Ligue só para investigar.
# DB_LOG_LENTO_MS=0
# Recuperação de senha (a web envia): mesmo provedor do worker.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# EMAIL_WEBHOOK_URL=
# Estado do PageSpeed na tela (a medição é do worker):
# PAGESPEED_API_KEY=
