# ──────────────────────────────────────────────────────────────────────────────
# JohnyWeb V2 — variáveis de ambiente
#
# Copie para `.env.local` em desenvolvimento. Em produção, defina no gestor de
# segredos da hospedagem. NUNCA registre valores reais neste arquivo.
# ──────────────────────────────────────────────────────────────────────────────

# Conexão administrativa: cria papéis, roda migrações, semeia demonstração.
# Papel com privilégio de criar tabelas. Só scripts usam esta variável.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/johnyweb

# Conexão da aplicação web. Papel `app_web`, restrito por RLS à conta da sessão.
# A senha deste papel é definida por `npm run db:setup`.
DATABASE_URL=postgres://app_web:troque-esta-senha@localhost:5432/johnyweb

# Conexão do worker (Fase 2). Papel `app_worker`: lê monitores, grava
# checagens, incidentes e heartbeat. Sem acesso a usuários ou contatos.
DATABASE_URL_WORKER=postgres://app_worker:troque-esta-senha@localhost:5432/johnyweb

# Conexões dos endpoints PÚBLICOS (Fase 4). Papéis de privilégio mínimo:
# app_ingest grava só sessões e eventos; app_forms grava só submissões e contatos.
DATABASE_URL_INGEST=postgres://app_ingest:troque-esta-senha@localhost:5432/johnyweb
DATABASE_URL_FORMS=postgres://app_forms:troque-esta-senha@localhost:5432/johnyweb

# Certificado raiz do provedor do banco, quando ele publica um. Com ele a
# cadeia TLS é verificada; sem ele, a conexão remota é cifrada mas não autenticada.
# DATABASE_SSL_CA=

# Segredo que assina os cookies de sessão. Mínimo 32 caracteres.
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# URL pública da central (sem barra final). Usada em links absolutos e na
# checagem de origem das mutações.
APP_URL=http://localhost:3000

# Worker de verificações (processo separado: npm run worker).
# WORKER_ID=worker-1
# Checagens simultâneas (padrão 5). Dimensione pela carteira: 100 sites a cada 5 min cabem em 5.
# MONITOR_CONCORRENCIA=5
# IPs PRIVADOS liberados explicitamente para o verificador, separados por vírgula.
# Só para rede própria ou testes. Numa instalação aberta, deixe vazio: é a defesa contra SSRF.
# MONITOR_EXCECOES_DE_REDE=

# Modo demonstração: a conta semeada por `npm run db:demo` é identificada na
# interface como demonstração. Nunca é usada como reserva quando um dado falta.
# DEMO_MODE=0

# Chave do Google PageSpeed Insights. Necessária na APLICAÇÃO (estado na tela) e
# no WORKER (medições). Sem ela, a integração aparece como "não configurada" —
# nunca como medição. Cota padrão da API: confira no console do Google; o worker
# trata 429 com retentativa e backoff, nunca com nota inventada.
# PAGESPEED_API_KEY=
# Medições simultâneas do PageSpeed no worker (padrão 2). Cada uma leva 30–60 s.
# PAGESPEED_CONCORRENCIA=2

# ──────────────────────────────────────────────────────────────────────────────
# E-mail de alertas (Fase 5). Lido pelo WORKER (quem envia) e pela APLICAÇÃO
# (que só mostra o estado). Sem EMAIL_PROVIDER, nada é enviado e a central diz
# "nenhum provedor configurado; alertas ficam só na central". Ligar o e-mail
# nas preferências sem provedor salva a preferência e não envia nada.
#
# EMAIL_PROVIDER: resend | postmark | webhook | log
#   resend    POST https://api.resend.com/emails — exige EMAIL_API_KEY e EMAIL_FROM
#   postmark  POST https://api.postmarkapp.com/email — exige EMAIL_API_KEY (server token) e EMAIL_FROM
#   webhook   POST EMAIL_WEBHOOK_URL com JSON {to, subject, text, alertId, from} — integra qualquer coisa;
#             EMAIL_API_KEY, se presente, vai como Authorization: Bearer
#   log       só registra no console do worker (desenvolvimento); NADA chega a uma caixa de entrada
# Entrega: uma por alerta × destinatário (nunca reenvia); 429/5xx/timeout tentam de
# novo com backoff (1, 2, 4, 8, 16 min, até 5 tentativas); outros 4xx falham de vez.
# Os links das mensagens usam APP_URL.
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=alertas@sua-agencia.com.br
# EMAIL_WEBHOOK_URL=
