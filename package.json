{
  "name": "johnyweb",
  "version": "2.0.0-fase1",
  "private": true,
  "description": "JohnyWeb V2 — central de acompanhamento dos sites entregues",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "design": "node tools/conferir-design.mjs",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:demo": "tsx scripts/demo.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restaurar": "tsx scripts/restaurar.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verificar": "npm run typecheck && npm run lint && npm run design && npm run test"
  },
  "dependencies": {
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
